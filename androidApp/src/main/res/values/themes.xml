<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        NoActionBar：应用自身的 Compose 界面没有 topAppBar（见 AppNavHost 的 Scaffold），
        若用系统默认主题会额外出现一条原生 ActionBar（应用名标题栏），与内容叠加表现为溢出。
        与 P5 前旧模块的 res/values/themes.xml 保持一致。

        windowLightStatusBar：这里的值只是「冷启动首帧的默认值」。Android 15（API 35）起对
        targetSdk >= 35 的应用强制 edge-to-edge，状态栏区域透出的是应用自己的内容/背景，
        图标若写死就必然有一方看不清（深色背景 + 深色图标 = 状态栏消失）。
        运行时由 com.rainccup.aktool.core.platform.SyncSystemBarAppearance 按当前主题重设：
        浅色主题用深色图标、深色主题用白色图标。values-night/ 里另放一份深色默认值，
        让系统已处于深色模式时首帧就用对颜色，不至于闪一下。
    -->
    <style name="Theme.AKTool" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
